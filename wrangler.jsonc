{
  "name": "emberhold",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayHub" }]
  },
  "migrations": [{ "tag": "relay-v1", "new_sqlite_classes": ["RelayHub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emberhold-db",
      "database_id": "a8573903-513f-42e0-9857-fe483709d7d5"
    }
  ]
}
