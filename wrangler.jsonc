{
  "name": "emberhold",
  "main": "cloudflare/_worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emberhold-db",
      "database_id": "a8573903-513f-42e0-9857-fe483709d7d5"
    }
  ]
}
